{
	"name": "drago-ex/project-backend-ui",
	"description": "Integration of a basic template for administration.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/translator": "^4.0.1",
		"drago-ex/project-user": "^1.0",
		"drago-ex/project-backend": "^1.0",
		"drago-ex/project-account": "^1.0 || ^2.0"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"replace-once": true,
				"replace-priority": 200,
				"replace": {
					"resources/app": "app",
					"resources/assets": "assets"
				}
			}
		},
		"drago-translator": {
			"translation": "app/Presentation/Backend/Admin/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
