# The administration menu; packages add their items in their own N.menu.neon next to their presenter (higher numbers load later).
parameters:
	sidebar:
		System:
			- {title: Dashboard, link: 'Admin:', icon: fa-solid fa-mug-hot bell, allowAny: [Backend:Admin, default-read]}

services:
	# numbers next to the items come from services tagged sidebar.badge (see SidebarMenu)
	- App\Presentation\Backend\Accessory\Menu\SidebarMenu(%sidebar%, tagged(sidebar.badge))
