{* items the user may not open are already left out by SidebarMenu::build(); the numbers are snippets named by
   their position, redrawn by the snippetArea sidebarBadges of the layout after AJAX requests *}
{varType array<string, App\Presentation\Backend\Accessory\Menu\SidebarItem[]> $sidebarMenu}

{foreach $sidebarMenu as $sectionTitle => $items}
	{var int $sectionNo = $iterator->counter}
	<ul class="list list-unstyled mb-0">
		<li class="list-item">
			<p class="list-title text-uppercase">{_$sectionTitle}</p>

			<!-- list items, first level -->
			<ul class="list-unstyled">
				{foreach $items as $item}
					{var int $itemNo = $iterator->counter}
					{do $hasSubmenu = $item->items !== []}
					<li>
						{do $link = $hasSubmenu ? '#' : $presenter->link($item->link)}
						{do $current = $presenter->isLinkCurrent($item->link)}
						{if $hasSubmenu}
							{foreach $item->items as $subItem}
								{do $current = $current || $presenter->isLinkCurrent($subItem->link)}
							{/foreach}
						{/if}
						<a href="{$link}" n:class="'list-link', $hasSubmenu ? 'link-arrow', $current ? 'link-current'">
							<div class="clearfix">
								<div class="float-start">
									<span n:if="$item->icon" class="list-icon">
										<i class="{$item->icon}"></i>
									</span>
									{_$item->title}
								</div>
								<div n:snippet="badge-{$sectionNo}-{$itemNo}" class="float-end"><span n:if="$item->badge" class="badge bg-primary">{$item->badge}</span></div>
							</div>
						</a>

						<!-- list items, second level -->
						<ul n:if="$hasSubmenu" class="list-unstyled list-hidden">
							{foreach $item->items as $subItem}
								{var int $subItemNo = $iterator->counter}
								<li>
									{do $current = $presenter->isLinkCurrent($subItem->link)}
									<a n:href="$subItem->link" n:class="'list-link', $current ? link-current">
										<div class="clearfix">
											<div class="float-start">{_$subItem->title}</div>
											<div n:snippet="badge-{$sectionNo}-{$itemNo}-{$subItemNo}" class="float-end"><span n:if="$subItem->badge" class="badge bg-primary">{$subItem->badge}</span></div>
										</div>
									</a>
								</li>
							{/foreach}
						</ul>
					</li>
				{/foreach}
			</ul>
		</li>
	</ul>
{/foreach}
