{* A bell in the navbar with what waits for the user (e.g. comments to approve, new orders): the entries of the
   badge services, see SidebarMenu::getNotifications(). Hidden when nothing waits. A dot on the bell says that
   something waits, the numbers are in the dropdown. *}
{varType list<array{link: string, count: int, label: string}> $notifications}

<div n:if="$notifications" class="dropdown">
	<button type="button" class="navbar-icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{_'Notifications'}">
		<i class="bi bi-bell" aria-hidden="true"></i>
		<span class="status-dot status-dot-pulse theme-danger"></span>
		<span class="navbar-icon-text d-none d-lg-inline">{_'Notifications'}</span>
	</button>
	<ul class="dropdown-menu dropdown-menu-end">
		<li><h6 class="dropdown-header">{_'Waiting for you'}</h6></li>
		<li n:foreach="$notifications as $notification">
			<a n:href="$notification[link]" class="dropdown-item d-flex align-items-center gap-3">
				<span class="me-auto">{_$notification[label]}</span>
				<span class="badge badge-subtle theme-primary">{$notification[count]}</span>
			</a>
		</li>
	</ul>
</div>
